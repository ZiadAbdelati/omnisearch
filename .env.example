# Required: seal API keys at rest (any long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Admin UI + /admin/api/*
ADMIN_TOKEN=change-me-admin-token

# Optional legacy seed: if set during first migration, this token becomes a managed API key.
# New deployments should generate /v1/search keys in the Admin UI → API keys.
# GATEWAY_API_TOKEN=change-me-gateway-token

HOST=0.0.0.0
PORT=8787

# SQLite path (default ./data/gateway.db)
# DATABASE_PATH=./data/gateway.db

# Optional default SearXNG seed on first boot (empty = skip)
# DEFAULT_SEARXNG_URL=http://searxng:8080

# Production hardening (Docker image sets these by default)
# NODE_ENV=production
# SG_ENFORCE_SECURE=1
# TRUST_PROXY=1
# RATE_LIMIT_GLOBAL_RPM=300
# RATE_LIMIT_SEARCH_RPM=60
# RATE_LIMIT_ADMIN_RPM=120
